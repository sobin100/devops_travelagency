pipeline{
    agent any

    environment{
        DOCKER_IMAGE = "sobine/my_travelagency"
        DOCKER_TAG = "ci"
        DOCKER_CLIENT_TIMEOUT = '300'
        COMPOSE_HTTP_TIMEOUT = '300'

    }

    stages{
        stage ('Checkout'){
             steps{
                checkout scm
            }
        }

        stage ('Build'){
            steps{
               sh  'docker-compose -f travelagency/docker-compose.yaml build --pull --no-cache'
            }
        }
        
        stage ('Migration and Test'){
            steps{
                sh 'docker-compose -f travelagency/docker-compose.yaml up -d web '
                sh 'docker-compose -f travelagency/docker-compose.yaml exec -T web python manage.py  migrate --noinput'
                sh 'docker-compose -f travelagency/docker-compose.yaml exec -T web python manage.py  test'
            }
        }

        stage ('Push'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]){
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker tag $DOCKER_IMAGE:$DOCKER_TAG $DOCKER_IMAGE:latest
                        docker push $DOCKER_IMAGE:$DOCKER_TAG
                        docker push $DOCKER_IMAGE:latest

                    '''
                }
            }
        }

        
    }

    post{
        success{
            emailext(
                to :'sobineh@gmail.com',
                subject :"CI SUCCESS:${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body : "The pipeline completed !"
            )

            
            echo "CD pipeline completed successfully"
        }
        failure{
            emailext(
                to :'sobineh@gmail.com',
                subject :"CI FAILURE:${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body : "The pipeline failed !"
            )
            echo "CD pipeline failed"
        }
    }

}