pipeline {
    agent any


    stages {
        stage('Checkout'){
            steps{
                checkout scm
            }
        }

        stage('Deploy'){
            steps{
                sshagent(['EC2_SSH_KEY2']){
                    sh '''
                        ssh -o StrictHostKeyChecking=no ec2-user@44.200.127.131 "
                        
                        cd /home/ec2-user/devops_travelagency &&
                        source env1/bin/activate &&
                        git pull origin main &&
                        cd travelagency  &&
                        docker-compose -f docker-compose.yaml pull web &&
                        docker-compose -f docker-compose.yaml stop web &&
                        docker-compose -f docker-compose.yaml rm -f web &&
                        docker-compose -f docker-compose.yaml up -d web &&
                        docker-compose -f docker-compose.yaml exec -T web python manage.py migrate --noinput
                     


                        "
                    '''

                }
            }
        }
        stage('Smoke Test'){
            steps{
                sh 'sleep 10'
                sh 'curl http://44.200.127.131:8000'

            }
        }
    }

    post{
        success{
            emailext(
                to : "sobineh@gmail.com",
                subject : "CD SUCCESS:${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body : "The pipeline completed !"
            )

            
            echo "CD pipeline completed successfully"
        }
        failure{
            emailext(
                to : "sobineh@gmail.com",
                subject : "CD FAILURE:${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body : "The pipeline failed !"
            )
            echo "CD pipeline failed"
        }
    }
}