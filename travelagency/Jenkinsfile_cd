pipeline {
    agent any


    stages {
        stage('Checkout'){
            steps{
                checkout scm
            }
        }

        stage('Deploy'){
            steps{
                sshagent(['EC2_SSH_KEY2']){
                    sh '''
                        ssh -o StrictHostKeyChecking=no ec2-user@98.92.193.108 "
                        
                        cd /home/ec2-user/devops_travelagency &&
                        source env1/bin/activate &&
                        git pull origin main &&
                        cd travelagency/  &&
                        docker-compose down &&
                        docker-compose pull &&
                        docker-compose up -d &&
                        docker-compose exec web python manage.py migrate --noinput



                        "
                    '''

                }
            }
        }
        stage('Smoke Test'){
            steps{
                sh 'sleep 10'
                sh 'curl http://98.92.193.108:8000'

            }
        }
    }

    post{
        success{
            echo "CD pipeline completed successfully"
        }
        failure{
            echo "CD pipeline failed"
        }
    }
}