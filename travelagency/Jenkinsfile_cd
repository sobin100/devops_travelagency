pipeline {
    agent any


    stages {
        stage('Checkout'){
            steps{
                checkout scm
            }
        }

        stage('Deploy'){
            steps{
                sshagent(['EC2_SSH_KEY2']){
                    sh '''
                        ssh -o StrictHostKeyChecking=no ec2-user@44.222.142.100 "
                        
                        cd /home/ec2-user/devops_travelagency &&
                        source env1/bin/activate &&
                        git pull origin main &&
                        cd travelagency  &&
                        docker-compose -f docker-compose.yaml down &&
                        docker-compose -f docker-compose.yaml pull &&
                        docker-compose -f docker-compose.yaml up -d &&
                        docker-compose -f docker-compose.yaml exec -T web python manage.py migrate --noinput
                        docker-compose -f docker-compose.yaml exec -T web python manage.py loaddata initial_data.json


                        "
                    '''

                }
            }
        }
        stage('Smoke Test'){
            steps{
                sh 'sleep 10'
                sh 'curl http://44.222.142.100:8000'

            }
        }
    }

    post{
        success{
            echo "CD pipeline completed successfully"
        }
        failure{
            echo "CD pipeline failed"
        }
    }
}